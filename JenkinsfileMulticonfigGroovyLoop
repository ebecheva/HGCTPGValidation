# This is a test Jenkinsfile,
# It is used in a "Pipeline" job, not "Multipipeline", doesn't need a PR to trigger the job
pipeline{
  agent {
    label 'llrgrhgtrig.in2p3.fr'
  }
  environment {
    LABEL_TEST='test'
    LABEL_REF='ref'
    CONFIG_SUBSET = 'default_subset'
    CHANGE_ID = 55
  }
  stages{
    stage("ReadSubsetlFile"){
      steps{
        sh 'python3 --version'
        sh 'pwd'
        script{
          def configVal = readYaml file: "./config/default_multi_subset.yaml"
          echo "configVal: " + configVal
          echo configVal['subsetName']
          echo configVal['description']
          echo configVal['nbConfigs']
          def nbc = configVal['nbConfigs']
          Integer nbrConfig = nbc as Integer
          echo configVal['configuration']['ref'][0]
          echo configVal['configuration']['test'][0]
          echo configVal['configuration']['ref'][1]
          echo configVal['configuration']['test'][1]
          env.SUBSET_NAME = configVal['subsetName']
          env.NB_CONFIGS = nbrConfig
          env.SUBSET_REF_1 = configVal['configuration']['ref'][0]
          env.SUBSET_TEST_1 = configVal['configuration']['test'][0]
          env.SUBSET_REF_2 = configVal['configuration']['ref'][1]
          env.SUBSET_TEST_2 = configVal['configuration']['test'][1]
          env.SUBSET_REF_3 = configVal['configuration']['ref'][2]
          env.SUBSET_TEST_3 = configVal['configuration']['test'][2]
          LABEL_TEST='test'
          LABEL_REF='ref'
          CONFIG_SUBSET = 'default_subset'
          env.EMAIL_TO=env.EMAIL_TO_EB
          env.BASE_REMOTE=env.BASE_REMOTE_EB
          env.DATA_DIR=env.DATA_DIR_EB
          env.BRANCH_VAL=env.BRANCH_VAL_EB
        }
        sh '''
        echo 'SUBSET_NAME = ' $SUBSET_NAME
        echo 'NB_CONFIGS = ' $NB_CONFIGS
        echo 'SUBSET_REF_1 = ' $SUBSET_REF_1
        echo 'SUBSET_TEST_1 = ' $SUBSET_TEST_1
        echo 'SUBSET_REF_2 = ' $SUBSET_REF_2
        echo 'SUBSET_TEST_2 = ' $SUBSET_TEST_2
        echo 'SUBSET_REF_3 = ' $SUBSET_REF_3
        echo 'SUBSET_TEST_3 = ' $SUBSET_TEST_3
        '''
      }
    }
    stage('CleanEnv'){
      steps{
        echo 'Clean the working environment.'
        sh '''
        counter=0
        while [ $counter -le $NB_CONFIGS ]
        do
           counter=$(( $counter + 1 ))
           echo $counter 
           echo ' Subset = ' SUBSET_TEST_$counter
           echo /data/jenkins/workspace/${DATA_DIR}/"PR${CHANGE_ID}"config$counter
           if [ -d "/data/jenkins/workspace/${DATA_DIR}/"PR${CHANGE_ID}"config$counter" ] 
           then
             rm -rf /data/jenkins/workspace/${DATA_DIR}/"PR${CHANGE_ID}"config$counter
           fi
        done
        '''
      }
    }
    stage('BuildCMSSWTest'){
      stages{
        stage('Install'){
          steps {
                  echo 'InstallCMSSW Test step..'
                   sh '''
                   pwd
                   SCRAM_ARCH='slc7_amd64_gcc10'
                   export SCRAM_ARCH
                   REF_RELEASE='CMSSW_12_1_0_pre3'
                   export REF_RELEASE
                   REMOTE='ebecheva'
                   export REMOTE
                   LABEL_TEST="test"
                   export LABEL_TEST
                   export CHANGE_BRANCH="fix-dev-CMSSW_12_1_0_pre3"
                   export CHANGE_TARGET="main-dev-CMSSW_12_1_0_pre3"
                   counter=1
                   echo 'SUBSET_TEST_$counter= ' SUBSET_TEST_$counter
                   while [ $counter -le $NB_CONFIGS ]
                   do
                     echo $counter
                     subset=SUBSET_TEST_$counter
                     sub=${!subset}
                     if [ !${REF_RELEASE}_HGCalTPGValidation_${sub}_${LABEL_TEST} ]
                     then
                       ./scripts/installCMSSW_multiconfig.sh $SCRAM_ARCH $REF_RELEASE $REMOTE $CHANGE_BRANCH $CHANGE_TARGET ${LABEL_TEST} $sub
                       counter=$(( $counter + 1 ))
                     else
                       echo 'The directory ${REF_RELEASE}_HGCalTPGValidation_${sub}_${LABEL_TEST} already exists.'
                       exit
                     fi
                    done
                   '''     
          }
        }
        stage('QualityChecks'){
          steps{
            sh '''
                SCRAM_ARCH='slc7_amd64_gcc10'
                export SCRAM_ARCH
                REF_RELEASE='CMSSW_12_1_0_pre3'
                export REF_RELEASE
                REMOTE='ebecheva'
                export REMOTE
                LABEL_TEST="test"
                export LABEL_TEST
                source /cvmfs/cms.cern.ch/cmsset_default.sh
                echo 'SUBSET_TEST_1= ' SUBSET_TEST_1
     
                # Apply QualityChecks only for the first config as the code is the same for the others
                subset=SUBSET_TEST_1
                sub=${!subset}
                echo "${REF_RELEASE}_HGCalTPGValidation_${sub}_${LABEL_TEST}/src"
                cd ${REF_RELEASE}_HGCalTPGValidation_${sub}_${LABEL_TEST}/src
                scram build code-checks
                scram build code-format
                GIT_STATUS=`git status --porcelain`
                if [ ! -z "$GIT_STATUS" ]; then
                    echo "Code-checks or code-format failed."
                    exit 1;
                fi
                cd ../..
            '''
          }
        }
        stage('Produce'){
            steps {
                sh '''
                pwd
                SCRAM_ARCH='slc7_amd64_gcc10'
                export SCRAM_ARCH
                REF_RELEASE='CMSSW_12_1_0_pre3'
                export REF_RELEASE
                REMOTE='ebecheva'
                export REMOTE
                LABEL_TEST="test"
                export LABEL_TEST
                export CHANGE_BRANCH="fix-dev-CMSSW_12_1_0_pre3"
                export CHANGE_TARGET="main-dev-CMSSW_12_1_0_pre3"
                source /cvmfs/cms.cern.ch/cmsset_default.sh
                counter=1
                while [ $counter -le $NB_CONFIGS ]
                do
                    echo $counter
                    subset=SUBSET_TEST_$counter
                    sub=${!subset}
                    if [ !${REF_RELEASE}_HGCalTPGValidation_${sub}_${LABEL_TEST} ]
                    then
                        cd ${REF_RELEASE}_HGCalTPGValidation_${sub}_${LABEL_TEST}/src
                        module use /opt/exp_soft/vo.llr.in2p3.fr/modulefiles_el7/
                        module purge
                        module load python/3.9.9
                        python --version
                        echo 'LABEL_TEST = ' ${LABEL_TEST}
                        python ../../scripts/produceData_from_configuration.py --subsetconfig ${sub} --label ${LABEL_TEST}
                    else
                        echo 'The data for this configuration have been already produced'
                        exit
                    fi
                done
                '''     
            }
        }  
    }
  }
  }
}
