pipeline{
  agent {
    label 'llrgrhgtrig.in2p3.fr'
  }
  environment {
    LABEL_TEST='test'
    LABEL_REF='ref'
    CONFIG_SUBSET = 'default_subset'
    CHANGE_ID = 55
  }
  stages{
    stage("ReadSubsetlFile"){
      steps{
        sh 'python3 --version'
        sh 'pwd'
        script{
          def configVal = readYaml file: "./config/default_multi_subset.yaml"
          echo "configVal: " + configVal
          echo configVal['subsetName']
          echo configVal['description']
          echo configVal['nbConfigs']
          def nbc = configVal['nbConfigs']
          Integer nbrConfig = nbc as Integer
          echo configVal['configuration']['ref'][0]
          echo configVal['configuration']['test'][0]
          echo configVal['configuration']['ref'][1]
          echo configVal['configuration']['test'][1]
          env.SUBSET_NAME = configVal['subsetName']
          env.NB_CONFIGS = nbrConfig
          env.SUBSET_REF_1 = configVal['configuration']['ref'][0]
          env.SUBSET_TEST_1 = configVal['configuration']['test'][0]
          env.SUBSET_REF_2 = configVal['configuration']['ref'][1]
          env.SUBSET_TEST_2 = configVal['configuration']['test'][1]
          env.SUBSET_REF_3 = configVal['configuration']['ref'][2]
          env.SUBSET_TEST_3 = configVal['configuration']['test'][2]
          LABEL_TEST='test'
          LABEL_REF='ref'
          CONFIG_SUBSET = 'default_subset'
          env.EMAIL_TO=env.EMAIL_TO_EB
          env.BASE_REMOTE=env.BASE_REMOTE_EB
          env.DATA_DIR=env.DATA_DIR_EB
          env.BRANCH_VAL=env.BRANCH_VAL_EB
        }
        sh '''
        echo 'SUBSET_NAME = ' $SUBSET_NAME
        echo 'NB_CONFIGS = ' $NB_CONFIGS
        echo 'SUBSET_REF_1 = ' $SUBSET_REF_1
        echo 'SUBSET_TEST_1 = ' $SUBSET_TEST_1
        echo 'SUBSET_REF_2 = ' $SUBSET_REF_2
        echo 'SUBSET_TEST_2 = ' $SUBSET_TEST_2
        echo 'SUBSET_REF_3 = ' $SUBSET_REF_3
        echo 'SUBSET_TEST_3 = ' $SUBSET_TEST_3
        '''
      }
    }
    stage('CleanEnv'){
      steps{
        echo 'Clean the working environment.'
        sh '''
        counter=0
        while [ $counter -le $NB_CONFIGS ]
        do
           counter=$(( $counter + 1 ))
           echo $counter 
           echo /data/jenkins/workspace/${DATA_DIR}/"PR${CHANGE_ID}"config$counter
           if [ -d "/data/jenkins/workspace/${DATA_DIR}/"PR${CHANGE_ID}"config$counter" ] 
             then
             rm -rf /data/jenkins/workspace/${DATA_DIR}/"PR${CHANGE_ID}"config$counter
           fi
        done
        '''
      }
    }
  }
}
