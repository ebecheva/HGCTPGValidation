pipeline{
  agent {
    label 'llrgrhgtrig.in2p3.fr'
  }
  stages{
    stage("ReadYamlFile"){
      steps{
        sh 'python3 --version'
        sh 'pwd'
        script{
          def configVal = readYaml file: "./config/default_multi_subset.yaml"
          echo "configVal: " + configVal
          echo configVal['subsetName']
          echo configVal['description']
          echo configVal['configuration']['ref'][0]
          echo configVal['configuration']['test'][0]
          echo configVal['configuration']['ref'][1]
          echo configVal['configuration']['test'][1]
          env.SUBSET_NAME = configVal['subsetName']
          env.SUBSET_REF_1 = configVal['configuration']['ref'][0]
          env.SUBSET_TEST_1 = configVal['configuration']['test'][0]
          env.SUBSET_REF_2 = configVal['configuration']['ref'][1]
          env.SUBSET_TEST_2 = configVal['configuration']['test'][1]
          env.SUBSET_REF_3 = configVal['configuration']['ref'][3]
          env.SUBSET_TEST_3 = configVal['configuration']['test'][3]
        }
        sh '''
        echo 'SUBSET_NAME = ' $SUBSET_NAME
        echo 'SUBSET_REF_1 = ' $SUBSET_REF_1
        echo 'SUBSET_TEST_1 = ' $SUBSET_TEST_1
        echo 'SUBSET_REF_2 = ' $SUBSET_REF_2
        echo 'SUBSET_TEST_2 = ' $SUBSET_TEST_2
        echo 'SUBSET_REF_3 = ' $SUBSET_REF_3
        echo 'SUBSET_TEST_3 = ' $SUBSET_TEST_3
        '''
      }
    }
  }
}
