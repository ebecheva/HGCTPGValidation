pipeline{
  agent {
    label 'llrgrhgtrig.in2p3.fr'
  }
  environment {
    LABEL_TEST = 'test'
    LABEL_REF = 'ref'
    CONFIG_SUBSET = 'default_multi_subset'
    REMOTE = 'ebecheva'
    SCRAM_ARCH = 'slc7_amd64_gcc10'
    REF_RELEASE = 'CMSSW_12_1_0_pre3'
    CHANGE_BRANCH = 'fix-dev-CMSSW_12_1_0_pre3'
    CHANGE_TARGET = 'main-dev-CMSSW_12_1_0_pre3'
    CHANGE_ID = 55
  }
  stages{
    stage('CleanEnv'){
      steps{
          echo 'Clean the working environment.'
          sh '''
          if [ -d "/data/jenkins/workspace/${DATA_DIR}/PR$CHANGE_ID" ] 
          then
              rm -rf /data/jenkins/workspace/${DATA_DIR}/PR$CHANGE_ID
          fi
          '''
      }
    }
    stage('BuildCMSSWTest'){
      stages{
        stage('Install'){
          steps {
              echo 'InstallCMSSW Test step..'
              sh '''
              pwd         
              ./scripts/installCMSSW.sh $SCRAM_ARCH $REF_RELEASE $REMOTE $CHANGE_BRANCH $CHANGE_TARGET ${LABEL_TEST}
              '''     
          }
        }
        stage('QualityChecks'){
          steps{
              sh '''
              source /cvmfs/cms.cern.ch/cmsset_default.sh
              echo 'SUBSET_TEST_1= ' SUBSET_TEST_1
              echo "${REF_RELEASE}_HGCalTPGValidation_${LABEL_TEST}/src"
              cd ${REF_RELEASE}_HGCalTPGValidation_${LABEL_TEST}/src
              scram build code-checks
              scram build code-format
              GIT_STATUS=`git status --porcelain`
              if [ ! -z "$GIT_STATUS" ]; then
                echo "Code-checks or code-format failed."
                exit 1;
              fi
              '''
          }
        }
        stage('Produce'){
          steps {
              sh '''
              pwd
              cd ./${REF_RELEASE}_HGCalTPGValidation_${LABEL_TEST}/src
              module use /opt/exp_soft/vo.llr.in2p3.fr/modulefiles_el7/
              module purge
              module load python/3.9.9
              python --version
              echo ' CONFIG_SUBSET = ' ${CONFIG_SUBSET}
              echo 'LABEL_TEST = ' ${LABEL_TEST}
              python ../../scripts/produceData_multiconfiguration.py --subsetconfig ${CONFIG_SUBSET} --label ${LABEL_TEST}
              '''     
          }
        }  
     }
    }
    stage('BuildCMSSWRef'){
      stages{
        stage('Install'){
          steps {
              echo 'InstallCMSSW Ref step..'
              sh '''
              pwd
              ./scripts/installCMSSW.sh $SCRAM_ARCH $REF_RELEASE $REMOTE $CHANGE_BRANCH $CHANGE_TARGET ${LABEL_REF}
              ''' 
          }
        }
        stage('Produce'){
          steps {
              sh '''
              pwd
              cd ./${REF_RELEASE}_HGCalTPGValidation_${LABEL_REF}/src
              module use /opt/exp_soft/vo.llr.in2p3.fr/modulefiles_el7/
              module purge
              module load python/3.9.9
              python --version
              echo ' CONFIG_SUBSET = ' ${CONFIG_SUBSET}
              echo 'LABEL_REF = ' ${LABEL_REF}
              python ../../scripts/produceData_multiconfiguration.py --subsetconfig ${CONFIG_SUBSET} --label ${LABEL_REF}
              ''' 
          }
        }
      }
    }
    stage('Display') {
        steps {
            sh '''
            source ./env_install.sh
            echo $PWD
            echo 'LABEL_TEST = ' ${LABEL_TEST}          
            python ./scripts/displayHistos.py --subsetconfig ${CONFIG_SUBSET} --refdir ${REF_RELEASE}_HGCalTPGValidation_${LABEL_REF}/src --testdir ${REF_RELEASE}_HGCalTPGValidation_${LABEL_TEST}/src              
            '''            
        }   
    }  
  } 
}
