pipeline{
  agent {
    label 'llrgrhgtrig.in2p3.fr'
  }
  environment {
    LABEL_TEST='test'
    LABEL_REF='ref'
    CONFIG_SUBSET = 'default_multi_subset'
    CHANGE_ID = 55
  }
  stages{
    stage('CleanEnv'){
      steps{
          echo 'Clean the working environment.'
          sh '''
          if [ -d "/data/jenkins/workspace/${DATA_DIR}/PR$CHANGE_ID" ] 
          then
              rm -rf /data/jenkins/workspace/${DATA_DIR}/PR$CHANGE_ID
          fi
          '''
      }
    }
    stage('BuildCMSSWTest'){
      stages{
        stage('Install'){
          steps {
              echo 'InstallCMSSW Test step..'
              sh '''
              pwd
              export SCRAM_ARCH='slc7_amd64_gcc10'
              export REF_RELEASE='CMSSW_12_1_0_pre3'
              REMOTE='ebecheva'
              export REMOTE
              export LABEL_TEST='test'
              export CHANGE_BRANCH='fix-dev-CMSSW_12_1_0_pre3'
              export CHANGE_TARGET='main-dev-CMSSW_12_1_0_pre3'
              ../HGCTPGValidation/scripts/installCMSSW.sh $SCRAM_ARCH $REF_RELEASE $REMOTE $CHANGE_BRANCH $CHANGE_TARGET ${LABEL_TEST}
              '''     
          }
        }
        stage('QualityChecks'){
          steps{
              sh '''
              export SCRAM_ARCH='slc7_amd64_gcc10'
              export REF_RELEASE='CMSSW_12_1_0_pre3'
              export REMOTE='ebecheva'
              export LABEL_TEST='test'
              source /cvmfs/cms.cern.ch/cmsset_default.sh
              echo 'SUBSET_TEST_1= ' SUBSET_TEST_1
     
              echo "${REF_RELEASE}_HGCalTPGValidation_${LABEL_TEST}/src"
              cd ${REF_RELEASE}_HGCalTPGValidation_${LABEL_TEST}/src
              scram build code-checks
              scram build code-format
              GIT_STATUS=`git status --porcelain`
              if [ ! -z "$GIT_STATUS" ]; then
                echo "Code-checks or code-format failed."
                exit 1;
              fi
              '''
          }
        }
        stage('Produce'){
          steps {
              sh '''
              pwd
              export CHANGE_TARGET='main-dev-CMSSW_12_1_0_pre3'
              export REF_RELEASE='CMSSW_12_1_0_pre3'
              export LABEL_TEST='test'
              cd test_dir/${REF_RELEASE}_HGCalTPGValidation_${LABEL_TEST}/src
              python --version
              echo ' CONFIG_SUBSET = ' ${CONFIG_SUBSET}
              echo 'LABEL_TEST = ' ${LABEL_TEST}
              python ../../../HGCTPGValidation/scripts/produceData_multiconfiguration.py --subsetconfig ${CONFIG_SUBSET} --label ${LABEL_TEST}
              '''     
          }
        }  
     }
    }
    stage('BuildCMSSWRef'){
      stages{
        stage('Install'){
          steps {
              echo 'InstallCMSSW Ref step..'
              sh '''
              pwd
              export SCRAM_ARCH='slc7_amd64_gcc10'
              export REF_RELEASE='CMSSW_12_1_0_pre3'
              REMOTE='ebecheva'
              export REMOTE
              export LABEL_TEST='ref'
              export CHANGE_BRANCH='fix-dev-CMSSW_12_1_0_pre3'
              export CHANGE_TARGET='main-dev-CMSSW_12_1_0_pre3'
              ../HGCTPGValidation/scripts/installCMSSW.sh $SCRAM_ARCH $REF_RELEASE $REMOTE $CHANGE_BRANCH $CHANGE_TARGET ${LABEL_TEST}
              ''' 
          }
        }
        stage('Produce'){
          steps {
              sh '''
              pwd
              export CHANGE_TARGET='main-dev-CMSSW_12_1_0_pre3'
              export REF_RELEASE='CMSSW_12_1_0_pre3'
              export LABEL_TEST='ref'
              cd test_dir/${REF_RELEASE}_HGCalTPGValidation_${LABEL_TEST}/src
              python --version
              echo ' CONFIG_SUBSET = ' ${CONFIG_SUBSET}
              echo 'LABEL_TEST = ' ${LABEL_TEST}
              python ../../../HGCTPGValidation/scripts/produceData_multiconfiguration.py --subsetconfig ${CONFIG_SUBSET} --label ${LABEL_TEST}
              ''' 
          }
        }
      }
    }
    stage('Display') {
        steps {
            sh '''
            cd test_dir
            source ../HGCTPGValidation/env_install.sh
            echo $PWD
            export REF_RELEASE='CMSSW_12_1_0_pre3'
            export TEST_RELEASE='CMSSW_12_1_0_pre3'
            export LABEL_REF='ref'
            export LABEL_TEST='test'
            echo 'LABEL_TEST = ' ${LABEL_TEST}
                
            ../HGCTPGValidation/scripts/displayHistos.py --subsetconfig ${CONFIG_SUBSET} --refdir ${REF_RELEASE}_HGCalTPGValidation_${LABEL_REF}/src --testdir ${TEST_RELEASE}_HGCalTPGValidation_${LABEL_TEST}/src              
            '''            
        }   
    }  
  } 
}
